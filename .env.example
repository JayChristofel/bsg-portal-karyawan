# ─────────────────────────────────────────────────────────────
#  SALIN KE .env / .env.local LALU ISI DENGAN NILAI ASLI.
#  JANGAN PERNAH MENARUH KREDENSIAL ASLI DI FILE INI.
#  File ini ter-track di git.
# ─────────────────────────────────────────────────────────────

# Koneksi Postgres / Supabase (transaction pooler, port 6543)
# Format: postgresql://<user>:<password>@<host>:6543/<db>
# Ambil dari Supabase Dashboard → Project Settings → Database.
DATABASE_URL=""

# (Opsional) PEM CA server database untuk verifikasi sertifikat TLS sungguhan.
# Tanpa ini, sslmode=verify-ca/verify-full hanya mengenkripsi koneksi (tidak
# memverifikasi sertifikat). Di satu baris, ganti newline dengan \n.
# DATABASE_SSL_CA=...

# Kunci enkripsi data sensitif (AES-256-GCM), minimal 32 karakter.
# Generate: openssl rand -base64 32
# ⚠️  Mengganti nilai ini membuat data lama tidak terbaca.
#    Jalankan `npm run db:reencrypt -- --old=<lama> --new=<baru> --apply` DULU.
ENCRYPTION_KEY=""

# Kunci penandatanganan JWT session cookie admin, minimal 32 karakter.
# Generate: openssl rand -base64 48
# ⚠️  Mengganti nilai ini akan mengakhiri semua session yang sedang aktif.
JWT_SECRET=""

# URL publik portal (tanpa slash akhir). Dipakai untuk {link} pada pengiriman
# otomatis (auto-resume) yang berjalan tanpa request browser. Di Vercel boleh
# dikosongkan bila VERCEL_PROJECT_PRODUCTION_URL tersedia.
# APP_URL=https://portal.contoh.id

# ── Gateway WhatsApp (OpenWA — https://github.com/rmyndharis/OpenWA) ──
WHATSAPP_API_URL=""
# Nama session OpenWA (dibuat otomatis lewat API bila belum ada).
WHATSAPP_DEVICE_ID="portal-pegawai"
# API key OpenWA (header X-API-Key). Dibuat saat boot pertama OpenWA,
# tersimpan di /app/data/.api-key pada instance gateway.
WHATSAPP_API_KEY=""

# Secret HMAC-SHA256 untuk memverifikasi signature inbound webhook
# (header X-OpenWA-Signature). Wajib diisi, jika tidak webhook akan
# menolak semua request. Harus sama dengan `secret` yang diset saat
# registrasi webhook di OpenWA (min. 16 karakter).
# Generate: openssl rand -hex 32
WHATSAPP_WEBHOOK_SECRET=""

# Secret HMAC-SHA256 untuk webhook event email (delivered/bounced/...).
# Provider harus menandatangani raw body dan mengirim header x-signature.
# Tanpa ini webhook email menolak semua request.
# EMAIL_WEBHOOK_SECRET=...

# Host yang diizinkan sebagai tujuan outbound ke gateway (opsional, comma-separated).
# Kosongkan untuk hanya mengandalkan proteksi jaringan privat.
# WHATSAPP_GATEWAY_ALLOWED_HOSTS="gateway.example.com,10.0.0.5"

# Rahasia untuk pemicu terjadwal /api/cron/auto-resume (Vercel Cron mengirimnya sebagai
# "Authorization: Bearer $CRON_SECRET"). Tanpa ini endpoint menolak semua request.
# CRON_SECRET=...

# DI VERCEL: tidak perlu diset. IP klien dibaca otomatis dari header yang ditimpa
# Vercel (VERCEL=1), dan cf-connecting-ip sengaja diabaikan karena bisa dipalsukan.
# Di luar Vercel (mis. tunnel Cloudflare):
# Header proxy (CF-Connecting-IP / X-Forwarded-For) hanya dipercaya bila =1.
# ⚠️  Set 1 HANYA kalau origin tidak bisa diakses langsung dari internet
#     (firewall / security group / bind interface privat). Kalau origin terbuka,
#     klien bisa memalsukan IP-nya sendiri dan melewati rate limit.
# Kalau kosong/tidak di-set, semua permintaan dianggap satu sumber (konservatif).
# TRUST_PROXY_HEADERS="1"

# Izinkan gateway berada di loopback/jaringan privat.
# HANYA untuk pengembangan lokal. JANGAN diaktifkan di produksi —
# ini membuat aplikasi rentan SSRF ke 127.0.0.1 dan cloud metadata.
# WHATSAPP_GATEWAY_ALLOW_PRIVATE_HOSTS="1"

# Izinkan URL gateway tanpa TLS.
# HANYA untuk pengembangan lokal dengan sertifikat self-signed.
# Untuk produksi, pasang CA gateway dan biarkan NODE_TLS_REJECT_UNAUTHORIZED
# pada nilai default (tidak di-set sama sekali).
# WHATSAPP_GATEWAY_ALLOW_INSECURE_HTTP="1"

# ─────────────────────────────────────────────────────────────
#  Trust TLS untuk gateway self-signed
# ─────────────────────────────────────────────────────────────
#  Bila OpenWA berada di belakang reverse proxy dengan sertifikat self-signed,
#  Node menolaknya (DEPTH_ZERO_SELF_SIGNED_CERT) sebelum status HTTP atau
#  API key sempat dievaluasi. Gejalanya: gateway terlihat "tidak bisa konek"
#  padahal sehat. Dengan sertifikat publik yang valid, bagian ini tidak perlu.
#
#  Verifikasi tetap AKTIF — sertifikat di-pin ke CA tertentu, bukan dibypass.
#  Prioritas resolution:
#    1. WHATSAPP_GATEWAY_CA_CERT      (disarankan, terutama di Vercel)
#    2. WHATSAPP_GATEWAY_CA_FILE      (path ke file PEM)
#    3. WHATSAPP_GATEWAY_TLS_INSECURE (hanya request ke gateway; opsi terakhir)
#
#  Untuk Vercel, pakai env var karena file tidak bisa di-mount ke bundle:
#    WHATSAPP_GATEWAY_CA_CERT="-----BEGIN CERTIFICATE-----
#    ...isi PEM di sini...
#    -----END CERTIFICATE-----"
#
#  Sertifikat bisa diambil dengan:
#    openssl s_client -connect <host>:443 </dev/null 2>/dev/null \
#      | openssl x509 -outform PEM > /path/ke/openwa-ca.pem
#
# ─────────────────────────────────────────────────────────────
#  JANGAN set NODE_TLS_REJECT_UNAUTHORIZED=0.
#  Nilai itu mematikan verifikasi TLS untuk SELURUH proses Node —
#  termasuk koneksi database — sehingga data bisa diintip/diubah
#  lewat serangan MITM. WHATSAPP_GATEWAY_ALLOW_INSECURE_HTTP bukan solusi yang
#  sama: ia hanya menurunkan persyaratan URL di sisi aplikasi, bukan membuat
#  Node menerima sertifikat self-signed.
# ─────────────────────────────────────────────────────────────

# ── SMTP Email Broadcast ───────────────────────────────────────
# CATATAN: variabel SMTP_HOST/PORT/USERNAME/PASSWORD/FROM_*/SECURE di bawah TIDAK
# dibaca aplikasi. SMTP diatur dari /admin/email/config (tersimpan di tabel settings).
# Konfigurasi SMTP custom (hosting sendiri atau perusahaan).
SMTP_HOST=""          # hostname SMTP server (contoh: smtp.mailgun.org)
SMTP_PORT=587         # port (587 untuk STARTTLS, 465 untuk SSL)
SMTP_USERNAME=""      # username SMTP auth
SMTP_PASSWORD=""      # password SMTP auth (di-encrypt di DB via ENCRYPTION_KEY)
SMTP_FROM_EMAIL=""    # pengirim default (contoh: no-reply@company.com)
SMTP_FROM_NAME=""     # nama pengirim default (contoh: Company Name)
SMTP_SECURE=false     # true = port 465 / false = STARTTLS di port 587

# Domain yang diizinkan sebagai tujuan outbound (opsional, comma-separated).
# Kosongkan untuk hanya mengandalkan proteksi jaringan privat.
# SMTP_ALLOWED_HOSTS="smtp.example.com,mail.example.com"

# Izinkan SMTP ke loopback/jaringan privat.
# HANYA untuk pengembangan lokal. JANGAN diaktifkan di produksi.
# SMTP_ALLOW_PRIVATE_HOSTS="1"
